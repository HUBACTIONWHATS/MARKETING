# Copie este arquivo para ".env" (nunca commitado — já está no .gitignore) e
# preencha com os valores reais. Sem esse arquivo, a aplicação roda normalmente
# em modo simulado; a integração com WhatsApp real fica desativada até aqui
# ser preenchido. Veja o passo a passo em CONEXAO_WHATSAPP.md.

# --- Sessão (login) ---
# Qualquer string longa e aleatória. Obrigatório trocar antes de expor a
# aplicação fora do seu computador (o valor padrão só serve para uso local).
SESSION_SECRET=

# --- WhatsApp Cloud API (Meta) — opcional, só preencha quando for conectar de verdade ---

# Token que você mesmo inventa (uma string longa e aleatória) e cadastra
# igual nos dois lados: aqui E no painel do Meta for Developers, no campo
# "Verify Token" da configuração do webhook. Usado só no momento em que a
# Meta confirma que o endereço do seu webhook é legítimo.
WHATSAPP_VERIFY_TOKEN=

# "App Secret" do seu app no Meta for Developers (Configurações do app >
# Básico > Chave Secreta do Aplicativo — clique em "Mostrar"). Usado para
# validar a assinatura de cada mensagem recebida (prova de que veio da Meta
# mesmo, e não de alguém que descobriu a URL do webhook).
WHATSAPP_APP_SECRET=

# Token de acesso para ENVIAR mensagens pela Graph API. Para teste, o token
# temporário (24h) gerado na tela "Configuração da API" do seu app já serve.
# Para produção, gere um token permanente via Usuário do Sistema (System
# User) — passo a passo em CONEXAO_WHATSAPP.md.
WHATSAPP_ACCESS_TOKEN=

# Versão da Graph API usada nas chamadas de envio. Atualize se a Meta
# depreciar a versão em uso (elas ficam disponíveis por cerca de 2 anos).
WHATSAPP_GRAPH_API_VERSION=v23.0
